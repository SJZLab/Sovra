{
  "name": "sovra",
  "private": true,
  "version": "0.0.0",
  "description": "Sovra (Model Factory) — JS/TS workspace root",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\" \"apps/web/package.json\" \"packages/shared/package.json\" \"package.json\"",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "8.2.4",
    "vitest": "^5.0.1"
  }
}
